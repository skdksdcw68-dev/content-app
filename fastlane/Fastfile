default_platform(:ios)

BUNDLE_ID   = "com.abelamare.contentapp"
XCODEPROJ   = "ContentApp.xcodeproj"
SCHEME      = "ContentApp"
PROFILE     = "content-app AppStore"

platform :ios do
  desc "Build and upload to TestFlight. The Xcode project is generated by " \
       "XcodeGen and the signing identity is installed by CI, both in earlier steps."
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    # No match. This app owns a dedicated distribution certificate and its own
    # provisioning profile, both created directly against the App Store Connect
    # API and delivered to CI as secrets. That keeps it completely independent
    # of the other apps on this team -- nothing shared, nothing to re-encrypt,
    # no certificates repo.
    #
    # code_sign_identity is the LEGACY "iPhone Distribution" type, not
    # "Apple Distribution". Apple caps Apple Distribution certificates at 2 per
    # account and both slots are held by drobe and remi. The legacy iOS
    # Distribution type has a separate quota; email-app took one of those, so
    # this app takes the other. That quota is now FULL -- see README.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "iPhone Distribution",
      profile_name: PROFILE,
      bundle_identifier: BUNDLE_ID
    )

    # GITHUB_RUN_NUMBER strictly increases per run, which is all App Store
    # Connect requires. Re-running the SAME failed run reuses the number -- if
    # that build already reached ASC, bump MARKETING_VERSION in project.yml.
    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: XCODEPROJ
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => PROFILE }
      }
    )

    # A build missing these keys is ACCEPTED by the upload and then silently
    # discarded during processing -- no build ever appears in TestFlight and
    # the only clue is an email. Fail here instead, before uploading.
    ipa = lane_context[SharedValues::IPA_OUTPUT_PATH]
    plist = sh("unzip -p '#{ipa}' 'Payload/*.app/Info.plist' | plutil -convert xml1 -o - -", log: false)
    %w[CFBundleIconName LSRequiresIPhoneOS CFBundleIdentifier CFBundleVersion].each do |k|
      UI.user_error!("Info.plist is missing #{k} -- App Store Connect would discard this build") unless plist.include?(k)
    end
    UI.success("Info.plist carries every key App Store processing requires")

    # ITMS-90129: Apple rejects binaries whose bundle/display name collides
    # with an existing App Store app. Its own first-party names are the
    # easiest to hit by accident. plutil extracts the value directly -- no
    # regex over XML, which is how email-app's first version of this broke.
    reserved = ["Mail", "Messages", "Photos", "Notes", "Music", "Files", "Maps", "Calendar", "Weather", "Clips", "Shortcuts"]
    display_name = sh(
      "unzip -p '#{ipa}' 'Payload/*.app/Info.plist' | plutil -extract CFBundleDisplayName raw -o - -",
      log: false
    ).strip
    if reserved.include?(display_name)
      UI.user_error!("CFBundleDisplayName #{display_name.inspect} is an Apple first-party app name -- App Store Connect rejects this with ITMS-90129")
    end
    UI.success("Display name #{display_name.inspect} is not a reserved Apple name")

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
