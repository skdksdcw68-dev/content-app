default_platform(:ios)

BUNDLE_ID   = "Autocast"
XCODEPROJ   = "ContentApp.xcodeproj"
SCHEME      = "ContentApp"
PROFILE     = "content-app AppStore"

platform :ios do
  desc "Build and upload to TestFlight. The Xcode project is generated by " \
       "XcodeGen and the signing identity is installed by CI, both in earlier steps."
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    # No match. This app owns a dedicated distribution certificate and its own
    # provisioning profile, both created directly against the App Store Connect
    # API and delivered to CI as secrets. That keeps it completely independent
    # of the other apps on this team -- nothing shared, nothing to re-encrypt,
    # no certificates repo.
    #
    # "Apple Distribution", the modern type -- NOT the legacy
    # "iPhone Distribution" that email-app and drobe use.
    #
    # Both quotas were full when this app was set up. The slot used here was
    # freed on 2026-09-04 by revoking the certificate behind Drobe's abandoned
    # fastlane-match profile, which signed nothing after Drobe moved to a
    # manual profile. Both legacy IOS_DISTRIBUTION slots are still full, which
    # is why this app does not simply copy email-app.
    #
    # Must stay in step with CERT_TYPE in scripts/bootstrap-signing.ts.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE,
      bundle_identifier: BUNDLE_ID
    )

    # Asked of App Store Connect rather than taken from the CI counter.
    #
    # The CI counter was the obvious choice and it broke the moment the project
    # moved to a second Codemagic account: that account's build index starts at
    # 1, so a build went up numbered 3 while ASC already held 19 through 29 for
    # this version. Apple discards a build whose number is not higher than the
    # last, and it does it during processing -- the upload succeeds, nothing
    # ever appears in TestFlight, and the only clue is an email.
    #
    # ASC is the only thing that actually knows what has been used, so it is
    # asked. That makes the number independent of which CI runs, how many times
    # it has run, and whether the account was replaced this morning.
    # Deliberately NOT filtered by version. The first attempt passed
    # `version: get_version_number(...)`, which reads the setting off the
    # target -- and MARKETING_VERSION is declared at project level here, so it
    # raised, the rescue swallowed it, and the whole thing quietly fell back to
    # the CI counter. That is how a build went up numbered 4 while 29 existed.
    #
    # What is wanted is the highest number ever used for this app, whatever
    # version it belonged to, because the counter only has to move forwards.
    # Unfiltered is both simpler and more correct.
    latest =
      begin
        latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID)
      rescue StandardError => e
        UI.important("Could not read the latest TestFlight build number (#{e.message})")
        nil
      end

    ci = (ENV["BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"]).to_i

    # Whichever is further along. The CI counter alone goes backwards when the
    # account changes; ASC alone would stall if it could not be read. Taking
    # the max means neither failure can produce a number that has been used.
    build_number = [latest.to_i + 1, ci, 1].max

    UI.message("Building as #{build_number} (TestFlight had #{latest || 'nothing readable'}, CI counter #{ci})")

    increment_build_number(
      build_number: build_number,
      xcodeproj: XCODEPROJ
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => PROFILE }
      }
    )

    # A build missing these keys is ACCEPTED by the upload and then silently
    # discarded during processing -- no build ever appears in TestFlight and
    # the only clue is an email. Fail here instead, before uploading.
    ipa = lane_context[SharedValues::IPA_OUTPUT_PATH]
    plist = sh("unzip -p '#{ipa}' 'Payload/*.app/Info.plist' | plutil -convert xml1 -o - -", log: false)
    %w[CFBundleIconName LSRequiresIPhoneOS CFBundleIdentifier CFBundleVersion].each do |k|
      UI.user_error!("Info.plist is missing #{k} -- App Store Connect would discard this build") unless plist.include?(k)
    end
    UI.success("Info.plist carries every key App Store processing requires")

    # ITMS-90129: Apple rejects binaries whose bundle/display name collides
    # with an existing App Store app. Its own first-party names are the
    # easiest to hit by accident. plutil extracts the value directly -- no
    # regex over XML, which is how email-app's first version of this broke.
    reserved = ["Mail", "Messages", "Photos", "Notes", "Music", "Files", "Maps", "Calendar", "Weather", "Clips", "Shortcuts"]
    display_name = sh(
      "unzip -p '#{ipa}' 'Payload/*.app/Info.plist' | plutil -extract CFBundleDisplayName raw -o - -",
      log: false
    ).strip
    if reserved.include?(display_name)
      UI.user_error!("CFBundleDisplayName #{display_name.inspect} is an Apple first-party app name -- App Store Connect rejects this with ITMS-90129")
    end
    UI.success("Display name #{display_name.inspect} is not a reserved Apple name")

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
